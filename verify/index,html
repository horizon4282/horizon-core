<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Proodos | Certificate Verification</title>
  <style>
    :root{font-family:system-ui,-apple-system,Segoe UI,Arial,sans-serif;color:#1c2a3b;background:#f3f6fa}
    body{margin:0;min-height:100vh;display:grid;place-items:center;padding:20px;box-sizing:border-box}
    main{width:min(100%,560px);background:white;padding:32px;border-radius:18px;box-shadow:0 8px 35px #18263b14}
    .eyebrow{color:#45668c;font-size:.85rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
    h1{font-size:1.7rem;margin:8px 0 20px}dl{display:grid;grid-template-columns:145px 1fr;gap:12px;margin:24px 0}
    dt{color:#64748b}dd{margin:0;font-weight:600;overflow-wrap:anywhere}.state{font-weight:700;color:#12643b}
    .error{color:#a52b2b}.muted{color:#64748b;font-size:.9rem}footer{margin-top:24px;border-top:1px solid #e6ebf0;padding-top:18px}
    @media(max-width:440px){main{padding:24px}dl{grid-template-columns:1fr;gap:4px}dd{margin-bottom:10px}}
  </style>
</head>
<body>
<main>
  <div class="eyebrow">Missão Proodos · Hope Class 2026</div>
  <h1>Verificação de certificado</h1>
  <div id="result" role="status" aria-live="polite">Consultando registro...</div>
  <footer class="muted">Este registro confirma apenas os dados publicados pela instituição emissora. Certificado de conclusão de curso livre.</footer>
</main>
<script>
(async () => {
  const result = document.getElementById('result');
  const parts = location.pathname.split('/').filter(Boolean);
  const verifyIndex = parts.indexOf('verify');
  const id = verifyIndex >= 0 ? (parts[verifyIndex + 1] || '').toUpperCase() : '';
  if (!/^HC-2026-\d{4}$/.test(id) || parts.length !== verifyIndex + 2) {
    result.innerHTML = '<p class="error">Código de certificado inválido ou ausente.</p>';
    return;
  }
  try {
    const response = await fetch('/verify/certificates.json', {cache:'no-store'});
    if (!response.ok) throw new Error('Registro indisponível');
    const records = await response.json();
    const record = Object.hasOwn(records, id) ? records[id] : null;
    if (!record || !record.name?.trim()) {
      result.innerHTML = '<p class="error">Certificado não localizado ou ainda não cadastrado.</p>';
      return;
    }
    const dl = document.createElement('dl');
    const add = (label, value, className='') => {
      const dt=document.createElement('dt'),dd=document.createElement('dd');
      dt.textContent=label;dd.textContent=value;if(className)dd.className=className;
      dl.append(dt,dd);
    };
    add('Registro',id);
    add('Aluno(a)',record.name);
    add('Curso',record.course || 'Hope Class — English Course');
    add('Instituição','Missão Proodos');
    add('Ano',String(record.year || 2026));
    const valid=record.status==='valid';
    add('Situação',valid?'Certificado válido':'Certificado não válido',valid?'state':'error');
    result.replaceChildren(dl);
  } catch(e) {
    result.innerHTML='<p class="error">Não foi possível consultar o registro. Tente novamente mais tarde.</p>';
  }
})();
</script>
</body>
</html>
